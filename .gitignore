# Generated Android build output (regenerated by android/build.sh)
android/build/
android/assets/
android/libs/android.jar
android/res/drawable/ic_launcher.jpg

# Signed builds and checksums (attach APKs to GitHub Releases instead)
release/*.apk
release/*.sha256

# Generated branding notice
tools/BRAND_NOTICE.txt

# Python and Node caches
__pycache__/
*.py[cod]
node_modules/
npm-debug.log*

# Local secrets and signing material
*.jks
*.keystore
*.p12
*.pem
*.pass
.env

# Editor and OS files
.DS_Store
*.swp
.idea/
.vscode/
